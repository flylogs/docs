---
// Starlight's page title plus two optional badge groups from the page frontmatter:
//   audience: who the page is for (account types, see company-management/account-types)
//   plan:     the lowest Flylogs plan that includes the feature (omitted = every plan)
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { audience = [], plan } = Astro.locals.starlightRoute.entry.data;

const AUDIENCE: Record<string, string> = {
  everyone: 'Everyone',
  managers: 'Managers',
  instructors: 'Instructors',
  pilots: 'Pilots',
  students: 'Students',
  mechanics: 'Mechanics',
  auditors: 'Auditors',
  developers: 'Developers',
};

const PLAN: Record<string, { label: string; title: string }> = {
  club: { label: 'Club Essentials and above', title: 'Included in the Club Essentials, Premium and Unlimited plans' },
  premium: { label: 'Premium and above', title: 'Included in the Premium and Unlimited plans' },
  unlimited: { label: 'Unlimited plan', title: 'Included in the Unlimited plan' },
  api: { label: 'API add-on, included in Unlimited', title: 'API access is included in Unlimited and available on Club Essentials and Premium as a paid add-on' },
};

const planInfo = plan ? PLAN[plan] : undefined;
---

<Default />
{
  (audience.length > 0 || planInfo) && (
    <div class="page-badges">
      {audience.length > 0 && (
        <a class="page-badge page-badge--audience" href="/company-management/account-types/" title="Account types this page is written for">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm0 2c-3.3 0-8 1.7-8 5v1h16v-1c0-3.3-4.7-5-8-5Z" /></svg>
          <span class="sr-only">For:</span>
          {audience.map((a) => AUDIENCE[a] ?? a).join(' · ')}
        </a>
      )}
      {planInfo && (
        <a class="page-badge page-badge--plan" href="https://flylogs.com/pricing" title={planInfo.title}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="m12 2 2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17l-6.1 3.4 1.5-6.8L2.2 9l6.9-.7Z" /></svg>
          <span class="sr-only">Plan:</span>
          {planInfo.label}
        </a>
      )}
    </div>
  )
}

<style>
  .page-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .page-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    line-height: 1.6;
    text-decoration: none;
    border: 1px solid transparent;
  }
  .page-badge--audience {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    border-color: var(--sl-color-hairline);
  }
  .page-badge--plan {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    border-color: var(--sl-color-accent);
  }
  .page-badge:hover {
    filter: brightness(1.08);
  }
</style>
